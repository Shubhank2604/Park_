# Infrastructure used by Docker Compose
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
MYSQL_DATABASE=park
MYSQL_USER=park
MYSQL_PASSWORD=replace_with_a_strong_app_password

# Spring Boot runtime
DB_URL=jdbc:mysql://localhost:3306/park?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=park
DB_PASSWORD=replace_with_the_same_app_password
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080

# Optional demo data. Keep disabled outside local development.
SEED_DATA_ENABLED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace_before_enabling
SEED_ATTENDANT_USERNAME=attendant1
SEED_ATTENDANT_PASSWORD=replace_before_enabling
SEED_USER_USERNAME=user1
SEED_USER_PASSWORD=replace_before_enabling
